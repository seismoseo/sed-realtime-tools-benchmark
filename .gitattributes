*.sh filter=redact
*.ipynb filter=redact
*.md filter=redact
*.txt filter=redact
*.csv filter=redact
*.json filter=redact
*.tsv filter=redact
*.cfg filter=redact
*.in filter=redact
*.run filter=redact
*.yml filter=redact
*.yaml filter=redact
